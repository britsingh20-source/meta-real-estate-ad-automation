{
  "name": "olivetree-ads-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "vars": {
    "ENABLE_WRITES": "false",
    "META_API_VERSION": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olivetree-ads-manager",
      "database_id": "61f5ab00-2c35-4337-9db0-d1bae994c790"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}